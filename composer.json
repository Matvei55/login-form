{
    "name": "my-blog/app",
    "description": "Simple blog with autoload",
    "type": "project",
    "require": {
        "php": ">=8.0",
        "ext-curl": "*",
        "robmorgan/phinx": "^0.16.11",
        "vlucas/phpdotenv": "^5.6"
    },
    "autoload": {
        "psr-4": {
            "App\\": "App/"
        }
    },
    "config": {
        "optimize-autoloader": true
    }
}
